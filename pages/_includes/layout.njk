<!DOCTYPE html>
<html lang="zh-CN" data-ink="paper">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · ZeroPhix</title>
<meta name="description" content="{{ desc }}">
<meta name="theme-color" content="#f0ede6" id="themeColor">
<link rel="canonical" href="https://zerophix.github.io{{ page.url }}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="ZeroPhix">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="https://zerophix.github.io{{ page.url }}">
{% if og_image %}
<meta property="og:image" content="https://zerophix.github.io{{ og_image }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://zerophix.github.io{{ og_image }}">
{% else %}
<meta name="twitter:card" content="summary">
{% endif %}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='4' fill='%23f0ede6'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='21' font-weight='700' fill='%2327457e' text-anchor='middle'%3EZ%3C/text%3E%3C/svg%3E">
<script>document.documentElement.classList.add('js');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500&family=Noto+Serif+SC:wght@300;400;600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css?v=82918e89">
</head>
<body>

<!-- GENERATED by Eleventy — 由 pages/ 源文件生成，勿直接编辑；改 pages/ 下的源文件 -->
<div class="grain" aria-hidden="true"></div>

<header class="mast">
  <div class="wrap mast-in">
    <a class="brand" href="/" aria-label="ZeroPhix，回到首页">
      <b>ZeroPhix</b><span class="tag">Personal Blog</span>
    </a>
    <nav class="nav" aria-label="站点导航">
      <a href="/#fields">领域</a>
      <a href="/#archive">归档</a>
      <a href="/code.html">作品</a>
    </nav>
    <div class="mast-right">
      <button class="tbtn" id="pageInkBtn" type="button" aria-pressed="false">夜读</button>
    </div>
  </div>
</header>

<main class="wrap page" id="top">
{{ content | safe }}
</main>

<footer class="foot">
  <div class="wrap">
    <div class="foot-in">
      <div class="foot-links">
        <a href="/">首页 / Home</a>
        <a href="/#archive">归档 / Archive</a>
        <a href="/code.html">作品 / Code</a>
        <a href="https://github.com/zerophix" target="_blank" rel="noopener">GitHub</a>
      </div>
      <p class="mono" style="margin:0">ZeroPhix · 一个人的博客</p>
    </div>
  </div>
</footer>

<script>
/* 与首页共享 zp-ink 主题键 */
(function(){
  var root=document.documentElement,
      btn=document.getElementById('pageInkBtn'),
      tc=document.getElementById('themeColor');
  function apply(v){
    root.setAttribute('data-ink',v);
    btn.setAttribute('aria-pressed', v==='night' ? 'true':'false');
    btn.textContent = v==='night' ? '纸张' : '夜读';
    if(tc) tc.setAttribute('content', v==='night' ? '#15140f' : '#f0ede6');
    try{ localStorage.setItem('zp-ink', v); }catch(e){}
  }
  var saved=null; try{ saved=localStorage.getItem('zp-ink'); }catch(e){}
  apply(saved==='night' ? 'night' : 'paper');
  btn.addEventListener('click', function(){
    apply(root.getAttribute('data-ink')==='night' ? 'paper' : 'night');
  });
})();
</script>

</body>
</html>
