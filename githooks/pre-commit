#!/bin/sh
# ═══════════════════════════════════════════
# 提交时自动挂载：pages/*.html → 站点根目录
#   1. Eleventy 构建（校验失败会中止提交，不要用 --no-verify 绕过）
#   2. 生成 mounted.js（首页归档收录）与 sitemap.xml
#   3. 精确暂存生成物，不碰无关的未暂存改动
#   4. 下架孤儿：源文件已删除的挂载页，连输出目录一起移除
# ═══════════════════════════════════════════
set -e
cd "$(git rev-parse --show-toplevel)"

if [ ! -x node_modules/.bin/eleventy ]; then
  echo "[pre-commit] 首次运行，安装依赖..."
  npm install --no-audit --no-fund
fi

echo "[pre-commit] Eleventy 挂载构建..."
node_modules/.bin/eleventy

# 精确暂存生成物（不碰无关的未暂存改动）
git add mounted.js sitemap.xml
mounted=0
for f in pages/*.html; do
  if [ ! -f "$f" ]; then continue; fi
  base=$(basename "$f")
  case "$base" in _*) continue ;; esac
  name="${base%.html}"
  git add "$name"
  mounted=$((mounted+1))
done

# 孤儿下架：源文件已删但输出还在
for d in */; do
  name="${d%/}"
  case "$name" in pages|works|githooks|node_modules) continue ;; esac
  if [ ! -f "$name/index.html" ]; then continue; fi
  if ! grep -q 'GENERATED by Eleventy' "$name/index.html"; then continue; fi
  if [ -f "pages/$name.html" ]; then continue; fi
  echo "[pre-commit] 下架孤儿挂载页 ./$name/"
  rm -rf "$name"
  if git ls-files -- "$name" | grep -q .; then
    git add -A -- "$name"
  fi
done

echo "[pre-commit] 挂载完成：$mounted 个挂载页 + mounted.js + sitemap.xml 已同步"
